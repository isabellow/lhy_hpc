              <scr:Script>import datetime

@returns(str)
def process(prefix):
  currentTime=datetime.datetime.now()
  return prefix+'/'+currentTime.strftime('%Y%m%d')+'/'</scr:Script>
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
