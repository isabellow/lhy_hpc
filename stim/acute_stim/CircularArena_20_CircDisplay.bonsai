                    <cv:Point>
                      <cv:X>4</cv:X>
                      <cv:Y>425</cv:Y>
                    </cv:Point>
                  </cv:ArrayOfPoint>
                </cv:Regions>
                <cv:MaskType>ToZero</cv:MaskType>
                <cv:FillValue>
                  <cv:Val0>145</cv:Val0>
                  <cv:Val1>145</cv:Val1>
                  <cv:Val2>145</cv:Val2>
                  <cv:Val3>255</cv:Val3>
